# Azure Document Intelligence Configuration
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-document-intelligence.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=your-document-intelligence-key
AZURE_DOCUMENT_INTELLIGENCE_TEMPLATE_MODEL=your-template-model
AZURE_DOCUMENT_INTELLIGENCE_NEURAL_MODEL=your-neural-model

# Azure Mistral Document AI Configuration
AZURE_MISTRAL_DOCUMENT_AI_ENDPOINT=https://your-mistral-document-ai-endpoint/providers/mistral/azure/ocr
AZURE_MISTRAL_DOCUMENT_AI_KEY=your-mistral-document-ai-key

# Azure Content Understanding Configuration
AZURE_CONTENT_UNDERSTANDING_ENDPOINT=https://your-content-understanding.cognitiveservices.azure.com/
AZURE_CONTENT_UNDERSTANDING_SUBSCRIPTION_KEY=your-content-understanding-subscription-key
