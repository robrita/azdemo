{
  "name": "pdf-chunks-index",
  "fields": [
    { "name": "id", "type": "Edm.String", "key": true, "filterable": false, "sortable": false, "facetable": false },

    // Document-level identity
    { "name": "documentId", "type": "Edm.String", "filterable": true, "sortable": true, "facetable": false },
    { "name": "documentUrl", "type": "Edm.String", "filterable": true, "facetable": false },
    { "name": "fileName", "type": "Edm.String", "searchable": false, "filterable": true, "sortable": true, "facetable": true },
    { "name": "filePath", "type": "Edm.String", "searchable": false, "filterable": true, "sortable": true, "facetable": true },
    { "name": "contentType", "type": "Edm.String", "searchable": false, "filterable": true, "facetable": true },

    // Document-level metadata (normalize values for filters/facets)
    { "name": "author", "type": "Edm.String", "searchable": false, "filterable": true, "facetable": true },
    { "name": "department", "type": "Edm.String", "searchable": false, "filterable": true, "facetable": true },
    { "name": "tags", "type": "Collection(Edm.String)", "searchable": false, "filterable": true, "facetable": true },
    { "name": "language", "type": "Edm.String", "searchable": false, "filterable": true, "facetable": true },
    { "name": "createdDate", "type": "Edm.DateTimeOffset", "filterable": true, "sortable": true, "facetable": true },
    { "name": "lastUpdated", "type": "Edm.DateTimeOffset", "filterable": true, "sortable": true, "facetable": true },

    // Chunk-level info
    { "name": "chunkId", "type": "Edm.String", "filterable": true, "sortable": true },
    { "name": "pageNumber", "type": "Edm.Int32", "filterable": true, "sortable": true, "facetable": true },
    { "name": "chunkIndex", "type": "Edm.Int32", "filterable": true, "sortable": true },
    { "name": "chunkCharStart", "type": "Edm.Int32", "filterable": true },
    { "name": "chunkCharEnd", "type": "Edm.Int32", "filterable": true },

    // Searchable text
    { "name": "title", "type": "Edm.String", "searchable": true, "analyzer": "en.lucene", "filterable": false, "sortable": false },
    { "name": "content", "type": "Edm.String", "searchable": true, "analyzer": "en.lucene" },
    { "name": "captions", "type": "Edm.String", "searchable": true, "analyzer": "en.lucene" }, // e.g., page headers/footers summarized
    { "name": "keyPhrases", "type": "Collection(Edm.String)", "searchable": true, "analyzer": "keyword" },

    // Vector embeddings (adjust dimensions to the model you use)
    { "name": "contentVector", "type": "Collection(Edm.Single)", "searchable": false, "filterable": false, "facetable": false, "dimensions": 1536, "vectorSearchProfile": "vs-profile" },
    { "name": "titleVector", "type": "Collection(Edm.Single)", "searchable": false, "filterable": false, "facetable": false, "dimensions": 1536, "vectorSearchProfile": "vs-profile" },

    // Attribution fields for RAG answers
    { "name": "snippet", "type": "Edm.String", "searchable": false },
    { "name": "sourceAnchor", "type": "Edm.String", "searchable": false } // e.g., "#page=10&section=3"
  ],
  "suggesters": [
    {
      "name": "sg-default",
      "searchMode": "analyzingInfixMatching",
      "sourceFields": ["fileName", "author", "tags", "title", "keyPhrases"]
    }
  ],
  "scoringProfiles": [
    {
      "name": "recencyBoost",
      "text": {
        "weights": { "title": 2, "content": 1, "captions": 0.5 }
      }, 
      "functions": [
        {
          "type": "freshness",
          "fieldName": "lastUpdated",
          "boost": 1.5,
          "interpolation": "linear",
          "freshness": { "boostingDuration": "P365D" }
        }
      ]
    }
  ],
  "semantic": {
    "configurations": [
      {
        "name": "semantic-default",
        "prioritizedFields": {
          "titleField": { "fieldName": "title" },
          "contentFields": [
            { "fieldName": "content" },
            { "fieldName": "captions" }
          ],
          "keywordFields": [
            { "fieldName": "keyPhrases" },
            { "fieldName": "tags" }
          ]
        }
      }
    ]
  },
  "analyzers": [
    // Add more language analyzers if multi-lingual; switch 'en.lucene' above accordingly
  ],
  "normalizers": [
    {
      "name": "lowercase-normalizer",
      "tokenFilters": ["lowercase"]
    }
  ],
  "synonymMaps": [
    {
      "name": "domainSynonyms",
      "format": "solr",
      "synonyms": "AI, artificial intelligence\nVM, virtual machine\nSLA, service level agreement"
    }
  ],
  "vectorSearch": {
    "algorithms": [
      {
        "name": "hnsw-1",
        "kind": "hnsw",
        "parameters": { "m": 24, "efConstruction": 300, "metric": "cosine" }
      }
    ],
    "profiles": [
      {
        "name": "vs-profile",
        "algorithm": "hnsw-1",
        "compression": { "kind": "none" }
      }
    ]
  }
}
