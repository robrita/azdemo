# Azure Functions Configuration Template
# Copy this file to .env and fill in your values

# Required: API Key for function authentication
API_KEY=your-api-key-here

# Optional: Request size limits (in MB)
MAX_REQUEST_SIZE_MB=10

# Optional: Default timeout for external service calls (in seconds)
DEFAULT_TIMEOUT_SECONDS=30

# Optional: Cosmos DB retry configuration
COSMOS_RETRY_MAX_ATTEMPTS=3
COSMOS_RETRY_BASE_DELAY=1.0

# Optional: Health check configuration
# If set, health endpoint will verify connectivity to these services
COSMOS_ENDPOINT=https://your-cosmos-account.documents.azure.com:443/
BLOB_ENDPOINT=https://your-storage-account.blob.core.windows.net/

# Note: Actual Cosmos DB and Blob Storage endpoints are passed via query parameters
# for each request. The above COSMOS_ENDPOINT and BLOB_ENDPOINT are only used for
# health checks to verify service connectivity.
