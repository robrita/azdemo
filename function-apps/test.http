### Query CosmosDB - Direct SQL Query (Get document by ID)
POST {{baseUrl}}/query_cosmosdb?cosmos_endpoint={{cosmosEndpoint}}&cosmos_database={{cosmosDatabase}}&cosmos_container={{cosmosContainer}}
X-API-Key: {{apiKey}}
Content-Type: text/plain

SELECT * FROM c WHERE c.id = "TS0yMDI0LTAxNy5wZGY.pdf"

### Query CosmosDB - Query by fileName
POST {{baseUrl}}/query_cosmosdb?cosmos_endpoint={{cosmosEndpoint}}&cosmos_database={{cosmosDatabase}}&cosmos_container={{cosmosContainer}}
X-API-Key: {{apiKey}}
Content-Type: text/plain

SELECT c.id, c.fileName, c.pageNumber, c.pageContent FROM c WHERE c.fileName = "TS0yMDI0LTAxNy5wZGY.pdf"

### Query CosmosDB - Get all documents (limit 10)
POST {{baseUrl}}/query_cosmosdb?cosmos_endpoint={{cosmosEndpoint}}&cosmos_database={{cosmosDatabase}}&cosmos_container={{cosmosContainer}}
X-API-Key: {{apiKey}}
Content-Type: text/plain

SELECT TOP 10 * FROM c

### Query CosmosDB - Count documents
POST {{baseUrl}}/query_cosmosdb?cosmos_endpoint={{cosmosEndpoint}}&cosmos_database={{cosmosDatabase}}&cosmos_container={{cosmosContainer}}
X-API-Key: {{apiKey}}
Content-Type: text/plain

SELECT VALUE COUNT(1) FROM c

### Query CosmosDB - Get distinct fileNames
POST {{baseUrl}}/query_cosmosdb?cosmos_endpoint={{cosmosEndpoint}}&cosmos_database={{cosmosDatabase}}&cosmos_container={{cosmosContainer}}
X-API-Key: {{apiKey}}
Content-Type: text/plain

SELECT DISTINCT c.fileName FROM c

### Query CosmosDB - WITH (CTE) Query
POST {{baseUrl}}/query_cosmosdb?cosmos_endpoint={{cosmosEndpoint}}&cosmos_database={{cosmosDatabase}}&cosmos_container={{cosmosContainer}}
X-API-Key: {{apiKey}}
Content-Type: text/plain

WITH filtered AS (SELECT * FROM c WHERE IS_DEFINED(c.fileName))
SELECT TOP 5 filtered.id, filtered.fileName FROM filtered

