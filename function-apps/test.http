X-API-Key: {{apiKey}}
Content-Type: application/json

{
  "id": "test-doc-001",
  "name": "Test Document",
  "description": "This is a test document for upsert operation",
  "tags": ["test", "sample"],
  "createdAt": "2025-11-07T00:00:00Z"
}

