  "content": "BASE64_ENCODED_LARGE_DOCUMENT_CONTENT_HERE",
  "content-type": "application/pdf"
}

### Extract Content - Resume Mode (Poll Existing Job)
# Use operation_location from a previous extraction response to resume polling
# acu_endpoint and content are not required in resume mode
POST {{baseUrl}}/extract_content?operation_location={{operationLocation}}&acu_key={{acuKey}}&polling_timeout=300&polling_interval=5
X-API-Key: {{apiKey}}
Content-Type: application/json

{
  "content-type": "application/pdf"
}

### Extract Content - Resume Mode with Header Authentication
POST {{baseUrl}}/extract_content?operation_location={{operationLocation}}&polling_timeout=600
X-API-Key: {{apiKey}}
X-ACU-Key: {{acuKey}}
Content-Type: application/json

{}

