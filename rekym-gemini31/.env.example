# =============================================================================
# Re-KYM Compliance Platform — Environment Configuration
# Copy to .env and fill in actual values. Never commit secrets to .env.
# See .rules/CONFIG_MANAGEMENT.md for conventions.
# =============================================================================

# ---- Cosmos DB (Required) ---------------------------------------------------
# Endpoint URL for your Azure Cosmos DB account.
COSMOS_ENDPOINT=https://<your-account>.documents.azure.com:443/
# Database name.
COSMOS_DATABASE=rekym
# Auth mode: "entra" (DefaultAzureCredential) or "key" (account key).
COSMOS_AUTH_MODE=entra
# Required when COSMOS_AUTH_MODE=key. Leave commented otherwise.
# COSMOS_KEY=<your-cosmos-account-key>

# ---- Google Drive (Required in staging/prod) --------------------------------
# Service-account credentials JSON file path or inline content.
GOOGLE_DRIVE_CREDENTIALS_JSON=path/to/service-account.json
# Shared Drive ID where merchant documents are stored.
GOOGLE_DRIVE_SHARED_DRIVE_ID=your-shared-drive-id

# ---- SSO / Auth (Required in staging/prod) ----------------------------------
# SSO token issuer URL (Entra ID v2.0 endpoint).
SSO_ISSUER=https://login.microsoftonline.com/your-tenant/v2.0
# SSO audience / client ID.
SSO_AUDIENCE=your-client-id
# Auth mode: "header" (validate X-User-* headers) or "disabled" (bypass auth).
# WARNING: "disabled" is blocked in production by startup validation.
# For local dev with the frontend login page, use "header" (recommended).
AUTH_MODE=header
# Dev persona used only when AUTH_MODE=disabled (bypasses auth entirely, no login page).
# Prefer AUTH_MODE=header + frontend VITE_AUTH_MODE=dev for interactive role switching.
DEV_PERSONA=admin

# ---- Rate Limits (Optional — sensible defaults provided) --------------------
RATE_LIMIT_TENANT_PER_MIN=120
RATE_LIMIT_TENANT_PER_HR=3000
RATE_LIMIT_USER_PER_MIN=30
RATE_LIMIT_USER_PER_HR=600

# ---- MFA Lockout (Optional — sensible defaults provided) --------------------
MFA_MAX_ATTEMPTS=5
MFA_LOCKOUT_MINUTES=30

# ---- App (Required) ---------------------------------------------------------
# Environment: "development", "staging", or "production".
APP_ENV=development
# Debug mode. WARNING: blocked in production by startup validation.
APP_DEBUG=true
# Public URL used for email links and frontend redirects.
APP_PUBLIC_URL=http://localhost:5173
# Allowed CORS origins (JSON array or comma-separated).
CORS_ORIGINS=["http://localhost:5173"]
# Static key for external scheduler nudge trigger (optional).
SCHEDULER_STATIC_KEY=

# ---- Email (Azure Logic App) ------------------------------------------------
# Azure Logic App HTTP trigger URL for sending emails.
# Contains a SAS signature — treat as a secret. Leave blank to use dev-stub logging.
EMAIL_LOGIC_APP_URL=https://prod-xx.eastus.logic.azure.com:443/workflows/...
# Shared secret for authenticating inbound email webhook calls (X-Webhook-Secret header).
# Must match the value configured in the Logic App that forwards partner replies.
WEBHOOK_EMAIL_SECRET=dev-webhook-secret-change-me

# ---- Observability (Optional — sensible defaults provided) ------------------
# Log level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
# Emit structured JSON logs (recommended for production).
LOG_JSON=true
# Include default uvicorn access logs (noisy; usually disabled).
LOG_INCLUDE_UVICORN_ACCESS=false
# Header name used for request correlation ID propagation.
CORRELATION_HEADER_NAME=X-Request-Id
# Azure Application Insights connection string (optional; set in cloud envs).
# APPLICATION_INSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=https://...

# ---- Azure Resource Identifiers (used by scripts only, not by Python app) ---
# AZURE_RESOURCE_GROUP=your-resource-group
# AZURE_PRINCIPAL_ID=your-principal-id
# AZURE_TENANT_ID=your-tenant-id
# COSMOS_ACCOUNT=your-cosmos-account-name
