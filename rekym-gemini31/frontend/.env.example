# =============================================================================
# Re-KYM Compliance Platform — Frontend Environment Variables
# Copy this file to .env.local and update values for your environment.
# =============================================================================

# Leave VITE_API_URL unset so the frontend uses /api/v1 (relative path).
# This works on any host: FastAPI (:8000), func start (:7071), or production.
# VITE_API_URL=/api/v1
#
# Frontend auth mode:
# - api: do not inject auth headers (default for production)
# - dev: show dev login page with role selector, inject persona headers
# VITE_AUTH_MODE=api
#
# Default role pre-selected on the dev login page (only used when VITE_AUTH_MODE=dev).
# The user can still pick any role from the dropdown.
# admin | compliance_officer | account_manager | maker | checker | supervisor | scheduler
# VITE_DEV_PERSONA=compliance_officer
#
# Backend environment variables belong in backend/.env (see backend/src/config.py).
