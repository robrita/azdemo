{
    "definition": {
        "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
        "contentVersion": "1.0.0.0",
        "triggers": {
            "Queue_file_trigger": {
                "type": "ApiConnection",
                "description": "Visibility timeout must be longer than the ff to avoid race condition.\n- max retry time delay\n- e2e process",
                "inputs": {
                    "host": {
                        "connection": {
                            "name": "@parameters('$connections')['azurequeues']['connectionId']"
                        }
                    },
                    "method": "get",
                    "path": "/v2/storageAccounts/@{encodeURIComponent(encodeURIComponent(parameters('queue_endpoint')))}/queues/@{encodeURIComponent(parameters('queue_name_file'))}/message_trigger",
                    "queries": {
                        "visibilitytimeout": "300"
                    }
                },
                "recurrence": {
                    "interval": 1,
                    "frequency": "Second",
                    "timeZone": "Singapore Standard Time"
                },
                "splitOn": "@triggerBody()?['QueueMessagesList']?['QueueMessage']"
            }
        },
        "actions": {
            "ACU_Parse": {
                "type": "Http",
                "description": "Parse the blob file as binary data",
                "inputs": {
                    "uri": "@parameters('acu_analyze')",
                    "method": "POST",
                    "headers": {
                        "Ocp-Apim-Subscription-Key": "@{parameters('acu_key')}",
                        "Content-Type": "application/octet-stream",
                        "x-ms-useragent": "content-understanding-document-extraction"
                    },
                    "body": "@base64ToBinary(body('Get_blob_content')?['$content'])"
                },
                "runAfter": {
                    "Get_blob_content": [
                        "Succeeded"
                    ]
                },
                "runtimeConfiguration": {
                    "contentTransfer": {
                        "transferMode": "Chunked"
                    }
                }
            },
            "ACU_result_polling": {
                "type": "Until",
                "expression": "@equals(variables('ParseStatus'), 'Succeeded')",
                "limit": {
                    "count": 10,
                    "timeout": "PT1H"
                },
                "actions": {
                    "ACU_Get": {
                        "type": "Http",
                        "description": "Poll the parsed result",
                        "inputs": {
                            "uri": "@outputs('ACU_Parse')?['headers']?['Operation-Location']",
                            "method": "GET",
                            "headers": {
                                "Ocp-Apim-Subscription-Key": "@{parameters('acu_key')}"
                            }
                        },
                        "runtimeConfiguration": {
                            "contentTransfer": {
                                "transferMode": "Chunked"
                            }
                        }
                    },
                    "Update_Status": {
                        "type": "SetVariable",
                        "inputs": {
                            "name": "ParseStatus",
                            "value": "@body('ACU_Get')?['status']"
                        },
                        "runAfter": {
                            "Delay": [
                                "Succeeded"
                            ]
                        }
                    },
                    "Delay": {
                        "type": "Wait",
                        "inputs": {
                            "interval": {
                                "count": 5,
                                "unit": "Second"
                            }
                        },
                        "runAfter": {
                            "ACU_Get": [
                                "Succeeded"
                            ]
                        }
                    }
                },
                "runAfter": {
                    "ACU_Parse": [
                        "Succeeded"
                    ]
                }
            },
            "Get_blob_name_by_id": {
                "type": "ApiConnection",
                "description": "Get the blob name from cosmos db",
                "inputs": {
                    "host": {
                        "connection": {
                            "name": "@parameters('$connections')['documentdb']['connectionId']"
                        }
                    },
                    "method": "get",
                    "path": "/v5/cosmosdb/@{encodeURIComponent(parameters('cosmosdb_account'))}/dbs/@{encodeURIComponent(parameters('cosmosdb_database'))}/colls/@{encodeURIComponent(parameters('cosmosdb_documents'))}/query",
                    "queries": {
                        "queryText": "SELECT * FROM c WHERE c.id = \"@{variables('MessageText')}\""
                    }
                },
                "runAfter": {
                    "Has_valid_delay": [
                        "Succeeded"
                    ]
                }
            },
            "Get_blob_content": {
                "type": "ApiConnection",
                "description": "Get the blob file using the blob name",
                "inputs": {
                    "host": {
                        "connection": {
                            "name": "@parameters('$connections')['azureblob']['connectionId']"
                        }
                    },
                    "method": "get",
                    "path": "/v2/datasets/@{encodeURIComponent(encodeURIComponent(parameters('storage_account')))}/files/@{encodeURIComponent(encodeURIComponent('/sharepoint/',body('Get_blob_name_by_id')?['value']?[0]?['blobName']))}/content",
                    "queries": {
                        "inferContentType": false
                    }
                },
                "runAfter": {
                    "Get_blob_name_by_id": [
                        "Succeeded"
                    ]
                },
                "metadata": {
                    "JTJmc2hhcmVwb2ludCUyZlNoYXJlZCUyYkRvY3VtZW50cyUyNTJmTWVtbyUyNTJmTS0yMDI0LTAzNS5wZGYuYmlu": "/sharepoint/Shared+Documents%2fMemo%2fM-2024-035.pdf.bin",
                    "JTJmc2hhcmVwb2ludCUyZlNoYXJlZF9Eb2N1bWVudHMtLU1lbW8tLU0tMjAyNC0wMzUucGRmLmpzb24=": "/sharepoint/Shared_Documents--Memo--M-2024-035.pdf.json",
                    "JTJmc2hhcmVwb2ludCUyZlNoYXJlZF9Eb2N1bWVudHMtLVRlc3QtLU0tMjAyNC0wMTcucGRmLmpzb24=": "/sharepoint/Shared_Documents--Test--M-2024-017.pdf.json",
                    "JTJmc2hhcmVwb2ludCUyZlNoYXJlZF9Eb2N1bWVudHMtLU90aGVycy0tMjAyNS0xMC0xNFQwOS01Nl9leHBvcnQuY3N2Lmpzb24=": "/sharepoint/Shared_Documents--Others--2025-10-14T09-56_export.csv.json",
                    "JTJmc2hhcmVwb2ludCUyZlNoYXJlZF9Eb2N1bWVudHMtLU90aGVycy0taW1hZ2VfKDMzKS5wbmcuanNvbg==": "/sharepoint/Shared_Documents--Others--image_(33).png.json",
                    "JTJmc2hhcmVwb2ludCUyZlNoYXJlZF9Eb2N1bWVudHMtLU90aGVycy0taW1hZ2VfKDM2KS5wbmcuanNvbg==": "/sharepoint/Shared_Documents--Others--image_(36).png.json",
                    "JTJmc2hhcmVwb2ludCUyZlNoYXJlZF9Eb2N1bWVudHMtLU90aGVycy0tYnNwLWFnZW50LWFyY2gucG5nLmpzb24=": "/sharepoint/Shared_Documents--Others--bsp-agent-arch.png.json",
                    "JTJmc2hhcmVwb2ludCUyZlNoYXJlZF9Eb2N1bWVudHMtLU90aGVycy0tRlkyNl9Db25uZWN0X0d1aWRhbmNlXy1fQXNpYS5kb2N4Lmpzb24=": "/sharepoint/Shared_Documents--Others--FY26_Connect_Guidance_-_Asia.docx.json",
                    "JTJmc2hhcmVwb2ludCUyZlNoYXJlZF9Eb2N1bWVudHMtLU90aGVycy0tT3ZlcnZpZXdfLV9DQUZfQURPX3RvX0dpdEh1Yl9NaWdyYXRpb24ucHB0eC5qc29u": "/sharepoint/Shared_Documents--Others--Overview_-_CAF_ADO_to_GitHub_Migration.pptx.json",
                    "JTJmc2hhcmVwb2ludCUyZlNoYXJlZF9Eb2N1bWVudHMtLU90aGVycy0tQVNFQU5fTUFDQy54bHN4Lmpzb24=": "/sharepoint/Shared_Documents--Others--ASEAN_MACC.xlsx.json",
                    "JTJmc2hhcmVwb2ludCUyZjEwMzQwNTYtYVcxaFoyVWdLRE0yS1M1d2JtYy5wbmcuanNvbg==": "/sharepoint/1034056-aW1hZ2UgKDM2KS5wbmc.png.json"
                }
            },
            "Is_PDF_File": {
                "type": "If",
                "description": "Check PDF file type",
                "expression": {
                    "and": [
                        {
                            "equals": [
                                "@body('Get_blob_name_by_id')?['value']?[0]?['fileType']",
                                "application/pdf"
                            ]
                        }
                    ]
                },
                "actions": {
                    "Split_Pages": {
                        "type": "Compose",
                        "description": "Split markdown data by '<!-- PageBreak -->' keyword",
                        "inputs": "@split(body('ACU_Get')?['result']?['contents']?[0]?['markdown'], '<!-- PageBreak -->')"
                    },
                    "Map_Pages_to_DB": {
                        "type": "Select",
                        "description": "Map all data to cosmos db schema",
                        "inputs": {
                            "from": "@range(0, length(outputs('Split_Pages')))",
                            "select": {
                                "id": "@{variables('MessageText')}_@{add(item(), 1)}",
                                "spId": "@body('Get_blob_name_by_id')?['value']?[0]?['spId']",
                                "path": "@body('Get_blob_name_by_id')?['value']?[0]?['path']",
                                "fileName": "@body('Get_blob_name_by_id')?['value']?[0]?['fileName']",
                                "fileId": "@variables('MessageText')",
                                "link": "@body('Get_blob_name_by_id')?['value']?[0]?['link']",
                                "fileType": "@body('Get_blob_name_by_id')?['value']?[0]?['fileType']",
                                "pageCount": "@length(outputs('Split_Pages'))",
                                "pageNumber": "@add(item(), 1)",
                                "pageContent": "@outputs('Split_Pages')[item()]"
                            }
                        },
                        "runAfter": {
                            "Split_Pages": [
                                "Succeeded"
                            ]
                        }
                    },
                    "Set_PDF_to_DocList": {
                        "type": "SetVariable",
                        "inputs": {
                            "name": "DocList",
                            "value": "@body('Map_Pages_to_DB')"
                        },
                        "runAfter": {
                            "Map_Pages_to_DB": [
                                "Succeeded"
                            ]
                        }
                    }
                },
                "else": {
                    "actions": {
                        "Set_Empty_DocList": {
                            "type": "SetVariable",
                            "description": "Indicates that DocList is empty",
                            "inputs": {
                                "name": "IsDocList",
                                "value": false
                            }
                        }
                    }
                },
                "runAfter": {
                    "ACU_result_polling": [
                        "Succeeded"
                    ]
                }
            },
            "Initialize_variable": {
                "type": "InitializeVariable",
                "inputs": {
                    "variables": [
                        {
                            "name": "ParseStatus",
                            "type": "string",
                            "value": "NotStarted"
                        },
                        {
                            "name": "MessageText",
                            "type": "string",
                            "value": "@{split(triggerBody()?['MessageText'],'--')[0]}"
                        },
                        {
                            "name": "MessageDelay",
                            "type": "string",
                            "value": "@{split(triggerBody()?['MessageText'],'--')[1]}"
                        },
                        {
                            "name": "DocList",
                            "type": "array"
                        },
                        {
                            "name": "RetryLimit",
                            "type": "integer",
                            "value": 2
                        },
                        {
                            "name": "IsDocList",
                            "type": "boolean",
                            "value": true
                        }
                    ]
                },
                "runAfter": {}
            },
            "For_each_item_in_DocList": {
                "type": "Foreach",
                "description": "Loop through each DocList array",
                "foreach": "@variables('DocList')",
                "actions": {
                    "Save_DocList_to_DB": {
                        "type": "ApiConnection",
                        "description": "Save each page document to cosmos db through upsert",
                        "inputs": {
                            "host": {
                                "connection": {
                                    "name": "@parameters('$connections')['documentdb']['connectionId']"
                                }
                            },
                            "method": "post",
                            "body": "@item()",
                            "headers": {
                                "x-ms-documentdb-is-upsert": true
                            },
                            "path": "/v2/cosmosdb/@{encodeURIComponent(parameters('cosmosdb_account'))}/dbs/@{encodeURIComponent(parameters('cosmosdb_database'))}/colls/@{encodeURIComponent(parameters('cosmosdb_pages'))}/docs"
                        }
                    }
                },
                "runAfter": {
                    "Is_PDF_File": [
                        "Succeeded"
                    ]
                }
            },
            "Is_last_retry": {
                "type": "If",
                "description": "DequeueCount indicates failure from prior execution",
                "expression": {
                    "and": [
                        {
                            "greater": [
                                "@int(triggerBody()?['DequeueCount'])",
                                "@variables('RetryLimit')"
                            ]
                        }
                    ]
                },
                "actions": {
                    "Delete_queue_file_2": {
                        "type": "ApiConnection",
                        "description": "Delete file queue to stop the retry",
                        "inputs": {
                            "host": {
                                "connection": {
                                    "name": "@parameters('$connections')['azurequeues']['connectionId']"
                                }
                            },
                            "method": "delete",
                            "path": "/v2/storageAccounts/@{encodeURIComponent(encodeURIComponent(parameters('queue_endpoint')))}/queues/@{encodeURIComponent(parameters('queue_name_file'))}/messages/@{encodeURIComponent(triggerBody()?['MessageId'])}",
                            "queries": {
                                "popreceipt": "@triggerBody()?['PopReceipt']"
                            }
                        }
                    },
                    "Terminate_retry": {
                        "type": "Terminate",
                        "inputs": {
                            "runStatus": "Failed",
                            "runError": {
                                "code": "429",
                                "message": "Retry Limit Error"
                            }
                        },
                        "runAfter": {
                            "Delete_queue_file_2": [
                                "Succeeded"
                            ]
                        }
                    }
                },
                "else": {
                    "actions": {}
                },
                "runAfter": {
                    "Initialize_variable": [
                        "Succeeded"
                    ]
                }
            },
            "Has_DocList": {
                "type": "If",
                "description": "",
                "expression": {
                    "and": [
                        {
                            "equals": [
                                "@variables('IsDocList')",
                                true
                            ]
                        }
                    ]
                },
                "actions": {
                    "Queue_on_pages": {
                        "type": "ApiConnection",
                        "description": "Set pages queue only for those that has DocList",
                        "inputs": {
                            "host": {
                                "connection": {
                                    "name": "@parameters('$connections')['azurequeues']['connectionId']"
                                }
                            },
                            "method": "post",
                            "body": "@{variables('MessageText')}",
                            "path": "/v2/storageAccounts/@{encodeURIComponent(encodeURIComponent(parameters('queue_endpoint')))}/queues/@{encodeURIComponent(parameters('queue_name_pages'))}/messages"
                        }
                    }
                },
                "else": {
                    "actions": {}
                },
                "runAfter": {
                    "For_each_item_in_DocList": [
                        "Succeeded"
                    ]
                }
            },
            "Delete_queue_file_1": {
                "type": "ApiConnection",
                "description": "Delete queue file to stop recurrence",
                "inputs": {
                    "host": {
                        "connection": {
                            "name": "@parameters('$connections')['azurequeues']['connectionId']"
                        }
                    },
                    "method": "delete",
                    "path": "/v2/storageAccounts/@{encodeURIComponent(encodeURIComponent(parameters('queue_endpoint')))}/queues/@{encodeURIComponent(parameters('queue_name_file'))}/messages/@{encodeURIComponent(triggerBody()?['MessageId'])}",
                    "queries": {
                        "popreceipt": "@triggerBody()?['PopReceipt']"
                    }
                },
                "runAfter": {
                    "Has_DocList": [
                        "Succeeded"
                    ]
                }
            },
            "Has_valid_delay": {
                "type": "If",
                "description": "Initial trigger has a valid delay, then will be replaced by X",
                "expression": {
                    "and": [
                        {
                            "not": {
                                "equals": [
                                    "@variables('MessageDelay')",
                                    "X"
                                ]
                            }
                        }
                    ]
                },
                "actions": {
                    "Rate_Limit_Delay": {
                        "type": "Wait",
                        "inputs": {
                            "interval": {
                                "count": "@int(variables('MessageDelay'))",
                                "unit": "Second"
                            }
                        }
                    },
                    "Delete_queue_file_3": {
                        "type": "ApiConnection",
                        "description": "Force delete queue containing delay value",
                        "inputs": {
                            "host": {
                                "connection": {
                                    "name": "@parameters('$connections')['azurequeues']['connectionId']"
                                }
                            },
                            "method": "delete",
                            "path": "/v2/storageAccounts/@{encodeURIComponent(encodeURIComponent(parameters('queue_endpoint')))}/queues/@{encodeURIComponent(parameters('queue_name_file'))}/messages/@{encodeURIComponent(triggerBody()?['MessageId'])}",
                            "queries": {
                                "popreceipt": "@triggerBody()?['PopReceipt']"
                            }
                        },
                        "runAfter": {
                            "Rate_Limit_Delay": [
                                "Succeeded"
                            ]
                        }
                    },
                    "Queue_file_no_delay": {
                        "type": "ApiConnection",
                        "description": "Recreate a queue with invalid delay",
                        "inputs": {
                            "host": {
                                "connection": {
                                    "name": "@parameters('$connections')['azurequeues']['connectionId']"
                                }
                            },
                            "method": "post",
                            "body": "@{variables('MessageText')}--X",
                            "path": "/v2/storageAccounts/@{encodeURIComponent(encodeURIComponent(parameters('queue_endpoint')))}/queues/@{encodeURIComponent(parameters('queue_name_file'))}/messages"
                        },
                        "runAfter": {
                            "Delete_queue_file_3": [
                                "Succeeded"
                            ]
                        }
                    },
                    "Terminate_delay": {
                        "type": "Terminate",
                        "inputs": {
                            "runStatus": "Cancelled"
                        },
                        "runAfter": {
                            "Queue_file_no_delay": [
                                "Succeeded"
                            ]
                        }
                    }
                },
                "else": {
                    "actions": {}
                },
                "runAfter": {
                    "Is_last_retry": [
                        "Succeeded"
                    ]
                }
            }
        },
        "outputs": {},
        "parameters": {
            "acu_analyze": {
                "defaultValue": "https://r0bfoundry.services.ai.azure.com/contentunderstanding/analyzers/bir2303-new:analyze?api-version=2025-05-01-preview&stringEncoding=utf16",
                "type": "String"
            },
            "acu_key": {
                "defaultValue": "<ACU KEY>",
                "type": "String"
            },
            "cosmosdb_account": {
                "defaultValue": "robaidoc",
                "type": "String"
            },
            "cosmosdb_database": {
                "defaultValue": "sharepoint",
                "type": "String"
            },
            "cosmosdb_documents": {
                "defaultValue": "documents",
                "type": "String"
            },
            "cosmosdb_pages": {
                "defaultValue": "pages",
                "type": "String"
            },
            "storage_account": {
                "defaultValue": "robaidoc",
                "type": "String"
            },
            "queue_endpoint": {
                "defaultValue": "robaidoc",
                "type": "String"
            },
            "queue_name_file": {
                "defaultValue": "sharepoint1",
                "type": "String"
            },
            "queue_name_pages": {
                "defaultValue": "pages",
                "type": "String"
            },
            "$connections": {
                "type": "Object",
                "defaultValue": {}
            }
        }
    },
    "parameters": {
        "$connections": {
            "type": "Object",
            "value": {
                "azurequeues": {
                    "id": "/subscriptions/860b4774-54d0-4b72-a79f-ce6e6c1011dc/providers/Microsoft.Web/locations/eastus/managedApis/azurequeues",
                    "connectionId": "/subscriptions/860b4774-54d0-4b72-a79f-ce6e6c1011dc/resourceGroups/demo2/providers/Microsoft.Web/connections/azurequeues",
                    "connectionName": "azurequeues",
                    "connectionProperties": {
                        "authentication": {
                            "type": "ManagedServiceIdentity"
                        }
                    }
                },
                "documentdb": {
                    "id": "/subscriptions/860b4774-54d0-4b72-a79f-ce6e6c1011dc/providers/Microsoft.Web/locations/eastus/managedApis/documentdb",
                    "connectionId": "/subscriptions/860b4774-54d0-4b72-a79f-ce6e6c1011dc/resourceGroups/demo2/providers/Microsoft.Web/connections/documentdb",
                    "connectionName": "documentdb",
                    "connectionProperties": {
                        "authentication": {
                            "type": "ManagedServiceIdentity"
                        }
                    }
                },
                "azureblob": {
                    "id": "/subscriptions/860b4774-54d0-4b72-a79f-ce6e6c1011dc/providers/Microsoft.Web/locations/eastus/managedApis/azureblob",
                    "connectionId": "/subscriptions/860b4774-54d0-4b72-a79f-ce6e6c1011dc/resourceGroups/demo2/providers/Microsoft.Web/connections/azureblob",
                    "connectionName": "azureblob",
                    "connectionProperties": {
                        "authentication": {
                            "type": "ManagedServiceIdentity"
                        }
                    }
                }
            }
        }
    }
}