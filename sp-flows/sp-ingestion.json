{
    "definition": {
        "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
        "contentVersion": "1.0.0.0",
        "triggers": {
            "HTTP_request_trigger": {
                "type": "Request",
                "description": "Can be triggered from onFileUpdate workflow",
                "kind": "Http",
                "inputs": {
                    "method": "POST"
                }
            }
        },
        "actions": {
            "For_each_item_in_the_library": {
                "type": "Foreach",
                "foreach": "@variables('FileList')",
                "actions": {
                    "If_this_is_a_File": {
                        "type": "If",
                        "description": "Check if it's a file or folder",
                        "expression": {
                            "and": [
                                {
                                    "equals": [
                                        "@items('For_each_item_in_the_library')['{IsFolder}']",
                                        false
                                    ]
                                }
                            ]
                        },
                        "actions": {
                            "Get_file_content": {
                                "type": "ApiConnection",
                                "description": "Get binary file content",
                                "inputs": {
                                    "host": {
                                        "connection": {
                                            "name": "@parameters('$connections')['sharepointonline_template']['connectionId']"
                                        }
                                    },
                                    "method": "get",
                                    "path": "/datasets/@{encodeURIComponent(encodeURIComponent(parameters('sharepoint_address')))}/files/@{encodeURIComponent(item()?['{Identifier}'])}/content",
                                    "queries": {
                                        "inferContentType": true
                                    }
                                }
                            },
                            "Save_blob_file": {
                                "type": "ApiConnection",
                                "description": "Store binary file as json in blob storage",
                                "inputs": {
                                    "host": {
                                        "connection": {
                                            "name": "@parameters('$connections')['azureblob']['connectionId']"
                                        }
                                    },
                                    "method": "post",
                                    "body": "@body('Get_file_content')",
                                    "headers": {
                                        "ReadFileMetadataFromServer": true
                                    },
                                    "path": "/v2/datasets/@{encodeURIComponent(encodeURIComponent(parameters('storage_account')))}/files",
                                    "queries": {
                                        "folderPath": "/sharepoint",
                                        "name": "@{outputs('Set_Unique_File_Name')}.json",
                                        "queryParametersSingleEncoded": true
                                    }
                                },
                                "runAfter": {
                                    "Set_Unique_File_Name": [
                                        "Succeeded"
                                    ]
                                },
                                "runtimeConfiguration": {
                                    "contentTransfer": {
                                        "transferMode": "Chunked"
                                    }
                                }
                            },
                            "Save_file_metadata": {
                                "type": "ApiConnection",
                                "description": "Save the file metadata in Cosmos DB",
                                "inputs": {
                                    "host": {
                                        "connection": {
                                            "name": "@parameters('$connections')['documentdb']['connectionId']"
                                        }
                                    },
                                    "method": "post",
                                    "body": {
                                        "id": "@{outputs('Set_Unique_File_Name')}",
                                        "path": "@{item()?['{Path}']}",
                                        "fileName": "@{item()?['{FilenameWithExtension}']}",
                                        "link": "@{item()?['{Link}']}",
                                        "fileType": "@{body('Get_file_content')?['$content-type']}",
                                        "blobName": "@{body('Save_blob_file')?['Name']}"
                                    },
                                    "headers": {
                                        "x-ms-documentdb-is-upsert": true
                                    },
                                    "path": "/v2/cosmosdb/@{encodeURIComponent(parameters('cosmosdb_account'))}/dbs/@{encodeURIComponent(parameters('cosmosdb_database'))}/colls/@{encodeURIComponent(parameters('cosmosdb_files'))}/docs"
                                },
                                "runAfter": {
                                    "Save_blob_file": [
                                        "Succeeded"
                                    ]
                                }
                            },
                            "Queue_on_file": {
                                "type": "ApiConnection",
                                "description": "Create a queue message with unique file identifier and time delay.",
                                "inputs": {
                                    "host": {
                                        "connection": {
                                            "name": "@parameters('$connections')['azurequeues']['connectionId']"
                                        }
                                    },
                                    "method": "post",
                                    "body": "@{outputs('Set_Unique_File_Name')}--@{variables('TimeDelay')}",
                                    "path": "/v2/storageAccounts/@{encodeURIComponent(encodeURIComponent(parameters('queue_endpoint')))}/queues/@{encodeURIComponent(parameters('queue_name_pages'))}/messages"
                                },
                                "runAfter": {
                                    "Increment_delay": [
                                        "Succeeded"
                                    ]
                                }
                            },
                            "File_Name_to_Base64": {
                                "type": "Compose",
                                "description": "Normalize the file name for downstream processing",
                                "inputs": "@replace(\r\n  replace(\r\n    replace(\r\n      replace(\r\n        replace(\r\n          replace(\r\n            base64(item()?['{FilenameWithExtension}']), '=', ''\r\n          ),\r\n          '/', '--'\r\n        ),\r\n        '\\', '-'\r\n      ),\r\n      '?', '-'\r\n    ),\r\n    '#', '-'\r\n  ),\r\n  '+', '_'\r\n)",
                                "runAfter": {
                                    "Get_file_content": [
                                        "Succeeded"
                                    ]
                                }
                            },
                            "Set_Unique_File_Name": {
                                "type": "Compose",
                                "description": "The unique file name will help deduplicate files automatically.\nOptional: outputs('Get_file_content')?['headers']?['Content-Length']",
                                "inputs": "@concat(\r\n  substring(\r\n    outputs('File_Name_to_Base64'),\r\n    0,\r\n    min(100, length(outputs('File_Name_to_Base64')))\r\n  ),\r\n  substring(item()?['{FilenameWithExtension}'], lastIndexOf(item()?['{FilenameWithExtension}'], '.'))\r\n)",
                                "runAfter": {
                                    "File_Name_to_Base64": [
                                        "Succeeded"
                                    ]
                                }
                            },
                            "Increment_delay": {
                                "type": "IncrementVariable",
                                "description": "This delay will act as time interval between each downstream execution to avoid hitting rate limits. ",
                                "inputs": {
                                    "name": "TimeDelay",
                                    "value": "@variables('TimeIncrement')"
                                },
                                "runAfter": {
                                    "Save_file_metadata": [
                                        "Succeeded"
                                    ]
                                }
                            }
                        },
                        "else": {
                            "actions": {}
                        }
                    }
                },
                "runAfter": {
                    "If_ingest_all_files": [
                        "Succeeded"
                    ]
                }
            },
            "If_ingest_all_files": {
                "type": "If",
                "description": "Decide whether to ingest all files or not\n-done by checking valid ID",
                "expression": {
                    "and": [
                        {
                            "equals": [
                                "@equals(triggerBody()?['ID'], null)",
                                true
                            ]
                        }
                    ]
                },
                "actions": {
                    "Pick_all_files_for_indexing": {
                        "type": "SetVariable",
                        "inputs": {
                            "name": "FileList",
                            "value": "@body('Get_files_properties_for_all_items_in_the_library')?['value']"
                        },
                        "runAfter": {
                            "Get_files_properties_for_all_items_in_the_library": [
                                "Succeeded"
                            ]
                        }
                    },
                    "Get_files_properties_for_all_items_in_the_library": {
                        "type": "ApiConnection",
                        "description": "Get all files properties in the library",
                        "inputs": {
                            "host": {
                                "connection": {
                                    "name": "@parameters('$connections')['sharepointonline_template']['connectionId']"
                                }
                            },
                            "method": "get",
                            "path": "/datasets/@{encodeURIComponent(encodeURIComponent(parameters('sharepoint_address')))}/tables/@{encodeURIComponent(encodeURIComponent(parameters('sharepoint_library')))}/getfileitems"
                        }
                    }
                },
                "else": {
                    "actions": {
                        "Append_onFileUpdate_data": {
                            "type": "AppendToArrayVariable",
                            "inputs": {
                                "name": "FileList",
                                "value": "@triggerBody()"
                            }
                        }
                    }
                },
                "runAfter": {
                    "Initialize_variable": [
                        "Succeeded"
                    ]
                }
            },
            "Initialize_variable": {
                "type": "InitializeVariable",
                "inputs": {
                    "variables": [
                        {
                            "name": "FileList",
                            "type": "array"
                        },
                        {
                            "name": "TimeDelay",
                            "type": "integer",
                            "value": 0
                        },
                        {
                            "name": "TimeIncrement",
                            "type": "integer",
                            "value": 10
                        }
                    ]
                },
                "runAfter": {}
            }
        },
        "outputs": {},
        "parameters": {
            "sharepoint_address": {
                "defaultValue": "https://microsoftapc.sharepoint.com/teams/RobAI-MilestoneTracker",
                "type": "String"
            },
            "sharepoint_library": {
                "defaultValue": "Documents",
                "type": "String"
            },
            "cosmosdb_account": {
                "defaultValue": "robaidoc",
                "type": "String"
            },
            "cosmosdb_database": {
                "defaultValue": "sharepoint",
                "type": "String"
            },
            "cosmosdb_files": {
                "defaultValue": "files",
                "type": "String"
            },
            "storage_account": {
                "defaultValue": "robaidoc",
                "type": "String"
            },
            "queue_endpoint": {
                "defaultValue": "robaidoc",
                "type": "String"
            },
            "queue_name_pages": {
                "defaultValue": "pages",
                "type": "String"
            },
            "$connections": {
                "type": "Object",
                "defaultValue": {}
            }
        }
    },
    "parameters": {
        "$connections": {
            "type": "Object",
            "value": {
                "sharepointonline_template": {
                    "id": "/subscriptions/860b4774-54d0-4b72-a79f-ce6e6c1011dc/providers/Microsoft.Web/locations/eastus/managedApis/sharepointonline",
                    "connectionId": "/subscriptions/860b4774-54d0-4b72-a79f-ce6e6c1011dc/resourceGroups/demo2/providers/Microsoft.Web/connections/sharepointonline"
                },
                "azureblob": {
                    "id": "/subscriptions/860b4774-54d0-4b72-a79f-ce6e6c1011dc/providers/Microsoft.Web/locations/eastus/managedApis/azureblob",
                    "connectionId": "/subscriptions/860b4774-54d0-4b72-a79f-ce6e6c1011dc/resourceGroups/demo2/providers/Microsoft.Web/connections/azureblob",
                    "connectionName": "azureblob",
                    "connectionProperties": {
                        "authentication": {
                            "type": "ManagedServiceIdentity"
                        }
                    }
                },
                "documentdb": {
                    "id": "/subscriptions/860b4774-54d0-4b72-a79f-ce6e6c1011dc/providers/Microsoft.Web/locations/eastus/managedApis/documentdb",
                    "connectionId": "/subscriptions/860b4774-54d0-4b72-a79f-ce6e6c1011dc/resourceGroups/demo2/providers/Microsoft.Web/connections/documentdb",
                    "connectionName": "documentdb",
                    "connectionProperties": {
                        "authentication": {
                            "type": "ManagedServiceIdentity"
                        }
                    }
                },
                "azurequeues": {
                    "id": "/subscriptions/860b4774-54d0-4b72-a79f-ce6e6c1011dc/providers/Microsoft.Web/locations/eastus/managedApis/azurequeues",
                    "connectionId": "/subscriptions/860b4774-54d0-4b72-a79f-ce6e6c1011dc/resourceGroups/demo2/providers/Microsoft.Web/connections/azurequeues",
                    "connectionName": "azurequeues",
                    "connectionProperties": {
                        "authentication": {
                            "type": "ManagedServiceIdentity"
                        }
                    }
                }
            }
        }
    }
}