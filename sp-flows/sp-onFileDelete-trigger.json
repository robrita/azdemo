{
    "definition": {
        "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
        "contentVersion": "1.0.0.0",
        "triggers": {
            "When_a_file_is_deleted": {
                "type": "ApiConnection",
                "inputs": {
                    "host": {
                        "connection": {
                            "name": "@parameters('$connections')['sharepointonline']['connectionId']"
                        }
                    },
                    "method": "get",
                    "path": "/datasets/@{encodeURIComponent(encodeURIComponent(parameters('sharepoint_address')))}/tables/@{encodeURIComponent(encodeURIComponent(parameters('sharepoint_library')))}/ondeletedfileitems"
                },
                "recurrence": {
                    "interval": 20,
                    "frequency": "Minute",
                    "timeZone": "Singapore Standard Time"
                },
                "splitOn": "@triggerBody()?['value']"
            }
        },
        "actions": {
            "Create_delete_queue": {
                "type": "ApiConnection",
                "inputs": {
                    "host": {
                        "connection": {
                            "name": "@parameters('$connections')['azurequeues']['connectionId']"
                        }
                    },
                    "method": "post",
                    "body": "@{triggerBody()}",
                    "path": "/v2/storageAccounts/@{encodeURIComponent(encodeURIComponent(parameters('queue_endpoint')))}/queues/@{encodeURIComponent(parameters('queue_name_delete'))}/messages"
                },
                "runAfter": {}
            }
        },
        "outputs": {},
        "parameters": {
            "sharepoint_address": {
                "defaultValue": "https://microsoftapc.sharepoint.com/teams/RobAI-MilestoneTracker",
                "type": "String"
            },
            "sharepoint_library": {
                "defaultValue": "Documents",
                "type": "String"
            },
            "queue_endpoint": {
                "defaultValue": "robaidoc",
                "type": "String"
            },
            "queue_name_delete": {
                "defaultValue": "delete",
                "type": "String"
            },
            "$connections": {
                "type": "Object",
                "defaultValue": {}
            }
        }
    },
    "parameters": {
        "$connections": {
            "type": "Object",
            "value": {
                "sharepointonline": {
                    "id": "/subscriptions/860b4774-54d0-4b72-a79f-ce6e6c1011dc/providers/Microsoft.Web/locations/eastus/managedApis/sharepointonline",
                    "connectionId": "/subscriptions/860b4774-54d0-4b72-a79f-ce6e6c1011dc/resourceGroups/demo2/providers/Microsoft.Web/connections/sharepointonline",
                    "connectionName": "sharepointonline"
                },
                "azurequeues": {
                    "id": "/subscriptions/860b4774-54d0-4b72-a79f-ce6e6c1011dc/providers/Microsoft.Web/locations/eastus/managedApis/azurequeues",
                    "connectionId": "/subscriptions/860b4774-54d0-4b72-a79f-ce6e6c1011dc/resourceGroups/demo2/providers/Microsoft.Web/connections/azurequeues",
                    "connectionName": "azurequeues",
                    "connectionProperties": {
                        "authentication": {
                            "type": "ManagedServiceIdentity"
                        }
                    }
                }
            }
        }
    }
}