{
    "definition": {
        "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
        "contentVersion": "1.0.0.0",
        "triggers": {
            "When_a_HTTP_request_is_received": {
                "type": "Request",
                "description": "Use this tool to search for BSP information",
                "kind": "Http",
                "inputs": {
                    "method": "POST",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "last_user_query": {
                                "description": "Last user request or query",
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "actions": {
            "AI_Search_Query": {
                "type": "Http",
                "inputs": {
                    "uri": "@parameters('ai_search_uri')",
                    "method": "POST",
                    "headers": {
                        "Content-Type": "application/json",
                        "api-key": "@{parameters('ai_search_key')}"
                    },
                    "body": {
                        "search": "@{triggerBody()?['last_user_query']}",
                        "count": true,
                        "top": 10,
                        "vectorQueries": [
                            {
                                "kind": "text",
                                "text": "@{triggerBody()?['last_user_query']}",
                                "fields": "vector"
                            }
                        ]
                    }
                },
                "runAfter": {
                    "Initialize_variables": [
                        "Succeeded"
                    ]
                },
                "runtimeConfiguration": {
                    "contentTransfer": {
                        "transferMode": "Chunked"
                    }
                }
            },
            "Select_all_pageContent": {
                "type": "Select",
                "inputs": {
                    "from": "@range(0, length(body('AI_Search_Query')?['value']))",
                    "select": "@body('AI_Search_Query')?['value']?[item()]?['pageContent']"
                },
                "runAfter": {
                    "AI_Search_Query": [
                        "Succeeded"
                    ]
                }
            },
            "Initialize_variables": {
                "type": "InitializeVariable",
                "inputs": {
                    "variables": [
                        {
                            "name": "pageContents",
                            "type": "array"
                        }
                    ]
                },
                "runAfter": {}
            },
            "HTTP_Response": {
                "type": "Response",
                "kind": "Http",
                "inputs": {
                    "statusCode": 200,
                    "body": "@if(\r\n  equals(body('RAG_LLM')?['choices']?[0]?['message']?['content'], null),\r\n  'Not Found',\r\n  body('RAG_LLM')?['choices']?[0]?['message']?['content']\r\n)"
                },
                "runAfter": {
                    "RAG_LLM": [
                        "SUCCEEDED"
                    ]
                }
            },
            "RAG_LLM": {
                "type": "Http",
                "inputs": {
                    "uri": "@parameters('openai_gpt_uri')",
                    "method": "POST",
                    "headers": {
                        "Content-Type": "application/json",
                        "Authorization": "Bearer @{parameters('openai_gpt_key')}"
                    },
                    "body": {
                        "messages": [
                            {
                                "role": "system",
                                "content": "You are a helpful assistant that answers questions based solely on the provided context from document retrieval.\n\n## Instructions:\n\n1. **Answer from context only**: Base your response exclusively on the information provided in the retrieved documents below. Do not use external knowledge or make assumptions.\n\n2. **Be specific and direct**: Provide concise, factual answers that directly address the user's question. Include relevant details, data, and quotes from the context when appropriate.\n\n3. **Handle irrelevant context**: If the retrieved documents do not contain information relevant to the user's question, explicitly state: \"I cannot answer this question based on the available documents.\"\n\n4. **Preserve accuracy**: \n   - Quote exact numbers, dates, names, and technical terms as they appear in the source\n   - Do not paraphrase in ways that change meaning\n   - If the context is ambiguous or incomplete, acknowledge this limitation\n\n5. **Cite sources**: Reference specific sections or document names when providing information to help users verify the answer.\n\n6. **Output format**: Provide answers in plain text only. Do not use JSON, markdown tables, or structured formats unless the user specifically requests them.\n\n---\n\nRetrieved Documents:\n@{union(body('Select_all_pageContent'), body('Select_all_pageContent'))}"
                            },
                            {
                                "role": "user",
                                "content": "@{triggerBody()?['last_user_query']}"
                            }
                        ],
                        "temperature": 0,
                        "top_p": 1
                    }
                },
                "runAfter": {
                    "Select_all_pageContent": [
                        "Succeeded"
                    ]
                },
                "runtimeConfiguration": {
                    "contentTransfer": {
                        "transferMode": "Chunked"
                    }
                }
            }
        },
        "outputs": {},
        "parameters": {
            "ai_search_uri": {
                "defaultValue": "https://aiengr.search.windows.net/indexes/sharepoint-search/docs/search?api-version=2025-08-01-preview",
                "type": "String"
            },
            "ai_search_key": {
                "defaultValue": "<SEARCH KEY>",
                "type": "String"
            },
            "openai_gpt_uri": {
                "defaultValue": "https://r0bai.cognitiveservices.azure.com/openai/deployments/gpt-4.1/chat/completions?api-version=2025-01-01-preview",
                "type": "String"
            },
            "openai_gpt_key": {
                "defaultValue": "<OPENAI GPT KEY>",
                "type": "String"
            },
            "$connections": {
                "type": "Object",
                "defaultValue": {}
            }
        }
    },
    "parameters": {
        "$connections": {
            "type": "Object",
            "value": {}
        }
    }
}