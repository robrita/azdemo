# Azure Functions Configuration Template
# Copy this file to .env and fill in your values

# Required: API Key for function authentication
API_KEY=your-api-key-here

# Optional: Request size limits (in MB)
MAX_REQUEST_SIZE_MB=10

# Optional: AI Search timeout configuration (in seconds)
AISEARCH_TIMEOUT_SECONDS=60

# Optional: Enable saving cropped signature images (debug/verification)
# Set to 'true' to save extracted signatures to ./tmp/ folder
SAVE_CROPS=false

# Optional: Azure Document Intelligence configuration
# If provided, signature extraction will use AI-powered custom neural model
# If not provided, falls back to traditional OpenCV contour detection
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=
AZURE_DI_MODEL_ID=prebuilt-layout

# Azure OpenAI Configuration (for signature_extraction_openai.ipynb)
# Required for OpenAI Vision-based signature extraction
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Azure Mistral Document AI Configuration (for signature_extraction_mistral_ai.ipynb)
# Required for Mistral Document AI-based signature extraction with bounding box annotations
AZURE_MISTRAL_DOCUMENT_AI_ENDPOINT=
AZURE_MISTRAL_DOCUMENT_AI_KEY=

# Azure Face API Configuration (for signature_extraction_openai.ipynb)
# Required for face detection to filter out faces before signature extraction
AZURE_FACE_API_KEY=
AZURE_FACE_ENDPOINT=https://robface.cognitiveservices.azure.com/
