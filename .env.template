# Azure Functions Configuration Template
# Copy this file to .env and fill in your values

# Required: API Key for function authentication
API_KEY=your-api-key-here

# Optional: Request size limits (in MB)
MAX_REQUEST_SIZE_MB=10

# Optional: AI Search timeout configuration (in seconds)
AISEARCH_TIMEOUT_SECONDS=60

# Optional: Enable local development features (debug image saving, etc.)
# Set to 'true' to enable local-only features like saving signatures to ./tmp/
ENABLE_LOCAL=false
