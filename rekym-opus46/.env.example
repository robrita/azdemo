# =============================================================================
# Application — Environment Configuration
# Copy to .env and fill in actual values. Never commit secrets to .env.
# See .rules/CONFIG_MANAGEMENT.md for conventions.
# =============================================================================

# ---- Cosmos DB (Required) ---------------------------------------------------
# Endpoint URL for your Azure Cosmos DB account.
COSMOS_ENDPOINT=https://<your-account>.documents.azure.com:443/
# Database name.
COSMOS_DATABASE=myapp
# Auth mode: "entra" (DefaultAzureCredential) or "key" (account key).
COSMOS_AUTH_MODE=entra
# Required when COSMOS_AUTH_MODE=key. Leave commented otherwise.
# COSMOS_KEY=<your-cosmos-account-key>

# ---- Auth (Required in staging/prod) ----------------------------------------
# Auth mode: "header" (validate headers) or "disabled" (bypass auth).
# WARNING: "disabled" is blocked in production by startup validation.
AUTH_MODE=disabled
# Dev persona used when AUTH_MODE=disabled.
DEV_PERSONA=admin

# ---- App (Required) ---------------------------------------------------------
# Environment: "development", "staging", or "production".
APP_ENV=development
# Debug mode. WARNING: blocked in production by startup validation.
APP_DEBUG=true
# Allowed CORS origins (JSON array or comma-separated).
CORS_ORIGINS=["http://localhost:5173"]

# ---- Observability (Optional — sensible defaults provided) ------------------
# Log level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
# Emit structured JSON logs (recommended for production).
LOG_JSON=true
# Header name used for request correlation ID propagation.
CORRELATION_HEADER_NAME=X-Request-Id
# Azure Application Insights connection string (optional; set in cloud envs).
# APPLICATION_INSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=https://...
