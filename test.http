###############################################################################
# ID Masking Routes
###############################################################################

### ID Masking - Basic Request (Both Face and ID Masking)
# Masks faces using Azure Face API and ID details using Azure Document Intelligence
# Preserves signature fields while masking other ID fields (name, address, ID numbers, etc.)
POST {{baseUrl}}/id_masking
X-API-Key: {{apiKey}}
Content-Type: application/json

{
  "filename": "valid_id.png",
  "content": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg=="
}

### ID Masking - Custom Model ID
# Use a specific Document Intelligence custom model for field detection
POST {{baseUrl}}/id_masking?model_id=valid_id2
X-API-Key: {{apiKey}}
Content-Type: application/json

{
  "filename": "driver_license.png",
  "content": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg=="
}

### ID Masking - Custom Padding
# Apply 10 pixels padding around masked regions
POST {{baseUrl}}/id_masking?padding=10
X-API-Key: {{apiKey}}
Content-Type: application/json

{
  "filename": "passport.png",
  "content": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg=="
}

### ID Masking - Skip Face Masking (ID Details Only)
# Only mask ID details, skip face detection/masking
POST {{baseUrl}}/id_masking?skip_face_masking=true
X-API-Key: {{apiKey}}
Content-Type: application/json

{
  "filename": "valid_id.png",
  "content": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg=="
}

### ID Masking - Skip ID Masking (Face Only)
# Only mask faces, skip ID detail masking
POST {{baseUrl}}/id_masking?skip_id_masking=true
X-API-Key: {{apiKey}}
Content-Type: application/json

{
  "filename": "selfie_with_id.png",
  "content": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg=="
}

### ID Masking - All Parameters Combined
# Custom model, padding, and face-only masking
POST {{baseUrl}}/id_masking?model_id=valid_id2&padding=8&skip_face_masking=false&skip_id_masking=false
X-API-Key: {{apiKey}}
Content-Type: application/json

{
  "filename": "id_card.png",
  "content": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg=="
}

### ID Masking - Both Masking Operations Skipped (Error Case)
# Should return 400 error - at least one masking operation must be enabled
POST {{baseUrl}}/id_masking?skip_face_masking=true&skip_id_masking=true
X-API-Key: {{apiKey}}
Content-Type: application/json

{
  "filename": "test.png",
  "content": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg=="
}

### ID Masking - Invalid Padding (Error Case)
# Should return 400 error for invalid padding value
POST {{baseUrl}}/id_masking?padding=invalid
X-API-Key: {{apiKey}}
Content-Type: application/json

{
  "filename": "test.png",
  "content": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg=="
}

### ID Masking - Missing Filename (Error Case)
