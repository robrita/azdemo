# =============================================================================
# Template Full-Stack App - Backend and Docker Environment
# Copy to .env and adjust values for your local environment.
# =============================================================================

# ---- Cosmos DB --------------------------------------------------------------
# For local Docker Compose, the template defaults to the Linux Cosmos emulator.
# For host-based local development, localhost works with the same emulator.
COSMOS_ENDPOINT=https://localhost:8081
COSMOS_DOCKER_ENDPOINT=https://cosmos:8081
COSMOS_DATABASE=templateapp
COSMOS_AUTH_MODE=key
COSMOS_KEY=C2y6yDjf5/R+ob0N8A7Cgv30VRDj6eGkjc+1234567890abcdefghijklmnopqrstuv==
COSMOS_SSL_VERIFY=false
COSMOS_AUTO_CREATE_CONTAINERS=true

# ---- App --------------------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
APP_PUBLIC_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173"]
AUTH_MODE=disabled
DEV_PERSONA=platform_admin
LOG_LEVEL=INFO
LOG_JSON=true
LOG_INCLUDE_UVICORN_ACCESS=false
CORRELATION_HEADER_NAME=X-Request-Id
APPLICATION_INSIGHTS_CONNECTION_STRING=

# ---- Optional external integrations ----------------------------------------
PARTNER_API_BASE_URL=
PARTNER_API_TIMEOUT_SECONDS=15